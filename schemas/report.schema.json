{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Advisor Report",
  "description": "MVP output contract for a validated architecture recommendation report.",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "request_summary",
    "recommendations",
    "rejected_alternatives",
    "constraint_analysis",
    "cost_estimate",
    "processing_feedback"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "recommendation",
        "needs_clarification",
        "cannot_recommend",
        "invalid_input"
      ]
    },
    "request_summary": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "rationale",
          "card_citations",
          "constraint_citations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "card_citations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "constraint_citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "rejected_alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "reason",
          "card_citations",
          "constraint_citations"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "card_citations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "constraint_citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^C-[0-9]{3,}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "constraint_analysis": {
      "type": "object",
      "required": [
        "used",
        "unused",
        "unavailable"
      ],
      "properties": {
        "used": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "constraint_id",
              "influence"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "pattern": "^C-[0-9]{3,}$"
              },
              "influence": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "unused": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "constraint_id",
              "reason"
            ],
            "properties": {
              "constraint_id": {
                "type": "string",
                "pattern": "^C-[0-9]{3,}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input_path",
              "impact"
            ],
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cost_estimate": {
      "type": "object",
      "required": [
        "status",
        "estimate"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_calculated",
            "calculated",
            "unavailable"
          ]
        },
        "estimate": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "processing_feedback": {
      "type": "object",
      "required": [
        "advisor_version",
        "synthesizer",
        "missing_information",
        "invalid_information",
        "unprocessed_input",
        "assumptions",
        "ambiguities",
        "clarifying_questions",
        "warnings",
        "quality_assessment"
      ],
      "properties": {
        "advisor_version": {
          "type": "string",
          "minLength": 1
        },
        "synthesizer": {
          "type": "object",
          "required": [
            "kind",
            "provider",
            "model"
          ],
          "properties": {
            "kind": {
              "enum": [
                "fake",
                "llm"
              ]
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input_path",
              "description",
              "blocking",
              "impact"
            ],
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              },
              "default_used": {},
              "impact": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "invalid_information": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input_path",
              "issue",
              "expected"
            ],
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "expected": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "unprocessed_input": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input_path",
              "reason"
            ],
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input_path",
              "assumed_value",
              "reason",
              "impact"
            ],
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "assumed_value": {},
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "input_path",
              "description",
              "impact"
            ],
            "properties": {
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "clarifying_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "question",
              "input_path",
              "blocking"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "input_path": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quality_assessment": {
          "type": "object",
          "required": [
            "status",
            "recommendation_confidence",
            "confidence_basis",
            "hallucination_risk"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_measured",
                "measured"
              ]
            },
            "recommendation_confidence": {
              "enum": [
                "not_assessed",
                "low",
                "medium",
                "high"
              ]
            },
            "confidence_basis": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "hallucination_risk": {
              "enum": [
                "not_assessed",
                "low",
                "medium",
                "high"
              ]
            },
            "measurement_method": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "recommendation"
          }
        }
      },
      "then": {
        "properties": {
          "recommendations": {
            "minItems": 1
          },
          "rejected_alternatives": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "needs_clarification",
              "cannot_recommend",
              "invalid_input"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recommendations": {
            "maxItems": 0
          },
          "rejected_alternatives": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_clarification"
          }
        }
      },
      "then": {
        "properties": {
          "processing_feedback": {
            "properties": {
              "clarifying_questions": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
